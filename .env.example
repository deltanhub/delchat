# DelChat Mobile Client Environment Variables (Template)
# Copy this file to .env and provide your actual development/production credentials.
# NEVER commit .env to source control.

# Supabase Project URL & Anon Key (Client-Safe)
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# DeltanHub Production/Staging API Gateway
EXPO_PUBLIC_DELTANHUB_API_URL=https://deltanhub.com
