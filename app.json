{
  "expo": {
    "name": "DelChat",
    "slug": "delchat",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "delchat",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.deltanhub.delchat",
      "buildNumber": "1",
      "entitlements": {
        "aps-environment": "production"
      },
      "associatedDomains": [
        "applinks:deltanhub.com"
      ],
      "infoPlist": {
        "NSFaceIDUsageDescription": "DelChat uses Face ID to secure your conversations and unlock the application.",
        "NSCameraUsageDescription": "DelChat requires camera access to allow you to make video calls and capture photo attachments for properties and messages.",
        "NSMicrophoneUsageDescription": "DelChat requires microphone access to enable high-definition voice calls and voice notes.",
        "NSPhotoLibraryUsageDescription": "DelChat requires access to your photo library to select and send property photos and document attachments.",
        "NSPhotoLibraryAddUsageDescription": "DelChat requires permission to save photos and media attachments to your device photo library.",
        "UIBackgroundModes": [
          "audio",
          "voip",
          "remote-notification",
          "fetch"
        ]
      }
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#1A050B",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "package": "com.deltanhub.delchat",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.BLUETOOTH",
        "android.permission.INTERNET",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_PHONE_CALL",
        "android.permission.MANAGE_OWN_CALLS",
        "android.permission.WAKE_LOCK"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "deltanhub.com",
              "pathPrefix": "/thread"
            },
            {
              "scheme": "https",
              "host": "deltanhub.com",
              "pathPrefix": "/call"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#1A050B"
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "DelChat requires camera access to allow you to make video calls and capture photo attachments for properties and messages.",
          "microphonePermission": "DelChat requires microphone access to enable high-definition voice calls and voice notes."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "DelChat requires access to your photo library to select and send property photos and document attachments."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#4a0f1f",
          "sounds": []
        }
      ],
      "expo-asset",
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "DelChat requires camera access to allow you to make video calls and capture photo attachments for properties and messages.",
          "microphonePermission": "DelChat requires microphone access to enable high-definition voice calls and voice notes."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f6e8bee6-85ad-4878-8b8e-592b409af7ed"
      }
    },
    "owner": "trust3690"
  }
}
